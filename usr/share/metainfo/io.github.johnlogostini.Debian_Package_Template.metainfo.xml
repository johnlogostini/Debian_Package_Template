    <url type="vcs-browser">
        https://github.com/johnlogostini/Debian_Package_Template
    </url>

    <developer id="io.github.johnlogostini">
        <name>JohnLogostini</name>
    </developer>

    <content_rating type="oars-1.1"/>

    <releases>
