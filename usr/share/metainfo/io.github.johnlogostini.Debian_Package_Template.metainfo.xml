<?xml version="1.0" encoding="UTF-8"?>

<component type="desktop-application">

    <!--
        For projects created from this template, replace this with
        a reverse-domain application ID.

        Examples:
            io.github.username.application
            com.example.application
    -->
    <id>io.github.johnlogostini.Debian_Package_Template</id>

    <name>Debian Package Template</name>

    <summary>Create professional Debian packages</summary>

    <metadata_license>CC0-1.0</metadata_license>

    <project_license>MIT</project_license>

    <description>
        <p>
            Debian Package Template is a reusable foundation for creating
            professional Debian packages.
        </p>

        <p>
            It provides a structured way to package applications with:
        </p>

        <ul>
            <li>Desktop integration</li>
            <li>AppStream metadata</li>
            <li>MIME file associations</li>
            <li>SVG application icons</li>
            <li>Bundled applications installed in /opt</li>
            <li>Example project files</li>
        </ul>
    </description>

    <launchable type="desktop-id">
        debian-package-template.desktop
    </launchable>

    <provides>
        <binary>debian-package-template</binary>
    </provides>

    <categories>
        <category>Development</category>
        <category>Utility</category>
    </categories>

    <keywords>
        <keyword>Debian</keyword>
        <keyword>Package</keyword>
        <keyword>Builder</keyword>
        <keyword>Development</keyword>
    </keywords>

    <url type="homepage">
        https://github.com/johnlogostini/Debian_Package_Template
    </url>

